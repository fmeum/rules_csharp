load("//csharp:defs.bzl", "csharp_binary", "csharp_library", "csharp_test")
load(":linux_cross_transition.bzl", "linux_binary_collector")
load(":test_helpers.bzl", "shell_test")

package(default_visibility = ["//visibility:public"])

csharp_library(
    name = "lib",
    srcs = ["Lib.cs"],
)

csharp_binary(
    name = "app",
    srcs = ["App.cs"],
    deps = [
        ":lib",
        "@nuget//:CommandLineParser",
        "@nuget//:Riok.Mapperly",
    ],
)

csharp_test(
    name = "smoke_test",
    srcs = ["App.cs"],
    deps = [
        ":lib",
        "@nuget//:CommandLineParser",
        "@nuget//:Riok.Mapperly",
    ],
)

csharp_test(
    name = "source_generator_test",
    srcs = ["App.cs"],
    deps = [
        ":lib",
        "@nuget//:CommandLineParser",
        "@nuget//:Riok.Mapperly",
    ],
)

# Invariant 2: ABI determinism proof
shell_test(
    name = "abi_determinism_test",
    src = "abi_determinism_test.sh",
    data = [
        "//tests/integration/abi_var1:lib",
        "//tests/integration/abi_var2:lib",
    ],
)

# Invariant 5: Cross-compiled Linux ARM64 binary verification
linux_binary_collector(
    name = "linux_arm64_app",
    binary = ":app",
)

shell_test(
    name = "linux_elf_test",
    src = "linux_elf_test.sh",
    data = [":linux_arm64_app"],
)

# Task 6: Csproj and BUILD synchronization round-trip test
shell_test(
    name = "sync_roundtrip_test",
    src = "sync_roundtrip_test.sh",
    data = ["//csharp:sync"],
)

# Section 10: Air-Gapped and Offline Mirror Resolution Test
shell_test(
    name = "offline_mirror_test",
    src = "offline_mirror_test.sh",
    data = [
        "//tests/integration:Directory.Packages.props",
        "//tests/integration:packages.lock.json",
    ],
)


