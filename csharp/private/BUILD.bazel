load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.bzl"]))

filegroup(
    name = "bzl_srcs",
    srcs = glob(["*.bzl"]),
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "providers_bzl",
    srcs = ["providers.bzl"],
)

bzl_library(
    name = "toolchain_impl_bzl",
    srcs = ["toolchain_impl.bzl"],
    deps = [":providers_bzl"],
)

bzl_library(
    name = "compile_bzl",
    srcs = ["compile.bzl"],
    deps = [":providers_bzl"],
)

bzl_library(
    name = "binary_bzl",
    srcs = ["binary.bzl"],
    deps = [
        ":compile_bzl",
        ":providers_bzl",
    ],
)

bzl_library(
    name = "nuget_repo_bzl",
    srcs = ["nuget_repo.bzl"],
    deps = ["@bazel_tools//tools/build_defs/repo:utils.bzl"],
)
